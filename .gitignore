# ===================================================
# PrintMate - Git Ignore Rules
# ===================================================

# 1. Environment & Secret Variables (NEVER commit to GitHub)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
local-agent/.env
local-agent/.env.*

# 2. Node.js Dependencies
node_modules/
backend/node_modules/
local-agent/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Ephemeral Customer Uploads & Temp Spooler Files
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
local-agent/temp/*
!local-agent/temp/.gitkeep

# 4. Logs and Run Artifacts
*.log
logs/

# 5. OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# 6. IDE & Editor Configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
